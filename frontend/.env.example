# Server-only FastAPI URL. Docker Compose supplies http://api:8000 at build time.
API_PROXY_TARGET=http://127.0.0.1:8000

# Public browser origin and exact remote media hosts accepted by Next image proxying.
NEXT_PUBLIC_AUTH_ORIGIN=https://misa.lol
NEXT_PUBLIC_MEDIA_HOSTS=r2.misa.lol,PROJECT_REF.supabase.co

# Optional; used by the original HTML auth pages through /js/config.js.
MISA_TURNSTILE_SITE_KEY=
