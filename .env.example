# Copy to .env on the VPS. Never commit or upload the filled-in file.

# Supabase Postgres session-pooler connection string.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_MAX_CONNECTIONS=10

# Generate a new value and use the same value for the API and data-api.
DATA_API_KEY=replace-with-a-new-random-64-character-key

MISA_ENVIRONMENT=production
MISA_DOMAIN=misa.lol
MISA_PUBLIC_BASE_URL=https://misa.lol
MISA_ADMIN_PUBLIC_URL=https://ukvhq.dev/m
MISA_CORS_ORIGINS=https://misa.lol,https://www.misa.lol,https://ukvhq.dev
MISA_TRUSTED_HOSTS=misa.lol,www.misa.lol,ukvhq.dev,localhost,127.0.0.1,api
MISA_ADMIN_USER_IDS=your-admin-user-uuid
SUPER_ADMIN_EMAIL=
MISA_ADMIN_TOKEN_SECRET=replace-with-a-long-random-secret
MISA_EMAIL_API_URL=
MISA_EMAIL_API_KEY=
MISA_EMAIL_FROM=Misa.lol <no-reply@misa.lol>
WEB_CONCURRENCY=2
RUST_LOG=info

# The site key is public; the secret key is server-only.
MISA_TURNSTILE_SITE_KEY=
MISA_TURNSTILE_SECRET_KEY=

# Supabase Storage. The service-role key is backend-only; never expose it to the browser.
MISA_SUPABASE_URL=https://PROJECT_REF.supabase.co
MISA_SUPABASE_SERVICE_ROLE_KEY=
MISA_STORAGE_BUCKET=misa-assets
# Exact additional CDN hosts the backend may fetch while rendering share images.
MISA_MEDIA_FETCH_HOSTS=
# Build-time browser crop/image proxy allowlist. Keep the legacy Supabase host only while needed.
NEXT_PUBLIC_MEDIA_HOSTS=r2.misa.lol,PROJECT_REF.supabase.co

# Optional social login providers. Keep all secrets on this VPS only.
MISA_GOOGLE_CLIENT_ID=
MISA_GOOGLE_CLIENT_SECRET=
MISA_DISCORD_CLIENT_ID=
MISA_DISCORD_CLIENT_SECRET=
MISA_TELEGRAM_BOT_TOKEN=
MISA_TELEGRAM_BOT_USERNAME=

# Cloudflare R2 profile media; keep secrets on the VPS only.
R2_ACCOUNT_ID=
R2_BUCKET=misa-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://r2.misa.lol
