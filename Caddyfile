misa.lol, www.misa.lol {
	encode gzip

	
	@admin_login path /admin/login /admin/login/*
	handle @admin_login {
		redir /admin 302
	}
	
	@admin_short path /admin /admin/*
	handle @admin_short {
		rewrite * /dashboard{uri}
		reverse_proxy frontend:3000
	}
	
	@admin_internal path /dashboard/admin /dashboard/admin/*
	handle @admin_internal {
		reverse_proxy frontend:3000
	}

	handle /dashboard* {
		reverse_proxy frontend:3000
	}
	handle {
		reverse_proxy api:8000
	}
}

ukvhq.dev {
	encode gzip

	
	handle /api* {
		reverse_proxy api:8000
	}

	
	
	handle_path /m/login* {
		rewrite * /dashboard/admin/login
		reverse_proxy frontend:3000
	}
	handle_path /m* {
		rewrite * /dashboard/admin
		reverse_proxy frontend:3000
	}

	
	handle /dashboard* {
		reverse_proxy frontend:3000
	}
	handle /_next* {
		reverse_proxy frontend:3000
	}

	handle / {
		redir https://ukvhq.dev/m 302
	}
	handle {
		respond "Not found" 404
	}
}
